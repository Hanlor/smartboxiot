
```env
# ===== SERVER =====
PORT=3000
NODE_ENV=development

# ===== SMS GATEWAY (BẮT BUỘC SỬA) =====
SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1/messages
SMS_GATEWAY_USER=your_username_here
SMS_GATEWAY_PASS=your_password_here

# ===== ADMIN (BẮT BUỘC ĐỔI) =====
ADMIN_SECRET_KEY=change_me_strong_password

# ===== RATE LIMIT =====
RATE_LIMIT_ENABLED=false

# ===== RETURN-TO-SENDER =====
RETURN_AFTER_HOURS=24
WARNING_BEFORE_HOURS=4
EXTENSION_HOURS=24
MAX_EXTENSIONS=1
RETURN_HOLD_HOURS=48